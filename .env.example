# Hosted providers — only the one you chose in setup.sh is needed.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Guard thresholds (optional; defaults shown)
# GUARD_MAX=6              # max sends to one recipient per window before tripping
# GUARD_WINDOW_MIN=10      # sliding window, minutes

# Output gate (optional)
# SWAMAI_GATE=1                                  # 0 disables the gate in the proxy
# SWAMAI_GATE_MODELS=qwen3-24k,qwen3-8b-24k      # ONLY these models are gated
