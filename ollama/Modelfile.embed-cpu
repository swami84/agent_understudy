# Embeddings on CPU.
#
# The embedding model is tiny (0.6B, ~1.4GB of compute buffers) but it competes
# for VRAM with whatever is serving chat. With Strata holding both 3090s, the
# reindex died with:
#   ggml_gallocr_reserve_n_impl: failed to allocate Vulkan0 buffer of size 1429844288
# Pinning it to CPU costs a slower index and removes the contention entirely.
FROM qwen3-embedding:0.6b
PARAMETER num_gpu 0
